#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

pthread_mutex_t mutex;
pthread_cond_t canRead, canWrite;

int readCount = 0;
int writerActive = 0;

// Reader
void* reader(void* arg) {
    int id = *(int*)arg;

    while (1) {
        pthread_mutex_lock(&mutex);

        // wait if writer is active
        while (writerActive) {
            pthread_cond_wait(&canRead, &mutex);
        }

        readCount++;
        pthread_mutex_unlock(&mutex);

        // Critical section (reading)
        printf("Reader %d is reading\n", id);
        sleep(1);

        pthread_mutex_lock(&mutex);
        readCount--;

        if (readCount == 0) {
            pthread_cond_signal(&canWrite); // allow writer
        }

        pthread_mutex_unlock(&mutex);
        sleep(1);
    }
    return NULL;
}

// Writer
void* writer(void* arg) {
    int id = *(int*)arg;

    while (1) {
        pthread_mutex_lock(&mutex);

        // wait if readers exist OR another writer active
        while (readCount > 0 || writerActive) {
            pthread_cond_wait(&canWrite, &mutex);
        }

        writerActive = 1;
        pthread_mutex_unlock(&mutex);

        // Critical section (writing)
        printf("Writer %d is writing\n", id);
        sleep(2);

        pthread_mutex_lock(&mutex);
        writerActive = 0;

        pthread_cond_broadcast(&canRead); // wake all readers
        pthread_cond_signal(&canWrite);   // wake one writer

        pthread_mutex_unlock(&mutex);
        sleep(2);
    }
    return NULL;
}

int main() {
    pthread_t r[3], w[2];
    int rid[3] = {1,2,3};
    int wid[2] = {1,2};

    pthread_mutex_init(&mutex, NULL);
    pthread_cond_init(&canRead, NULL);
    pthread_cond_init(&canWrite, NULL);

    for(int i = 0; i < 3; i++)
        pthread_create(&r[i], NULL, reader, &rid[i]);

    for(int i = 0; i < 2; i++)
        pthread_create(&w[i], NULL, writer, &wid[i]);

    for(int i = 0; i < 3; i++)
        pthread_join(r[i], NULL);

    for(int i = 0; i < 2; i++)
        pthread_join(w[i], NULL);

    return 0;
}
