#include <iostream>
#include <unistd.h>
#include <cstring>
#include <sys/wait.h>

int main()
{
    int fd[2];
    pipe(fd);

    pid_t pid = fork();

    if(pid == 0)
    {
        close(fd[0]);

        write(fd[1],
              "Hello Parent",
              13);

        close(fd[1]);
    }
    else
    {
        close(fd[1]);

        char buffer[100];

        read(fd[0],
             buffer,
             sizeof(buffer));

        std::cout << buffer << std::endl;

        close(fd[0]);

        wait(nullptr);
    }
}


/// example with dup with stdin and stdout 
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main()
{
    int pipefd[2];

    // pipefd[0] = read end
    // pipefd[1] = write end
    pipe(pipefd);

    pid_t pid = fork();

    if (pid == 0) {
        // Child

        close(pipefd[1]);  // Child doesn't write

        // Make pipe read end become stdin
        dup2(pipefd[0], STDIN_FILENO);

        close(pipefd[0]);

        // Now stdin comes from the pipe
        char buffer[100];

        read(STDIN_FILENO, buffer, sizeof(buffer));
        printf("Child received: %s\n", buffer);

        exit(0);
    }
    else {
        // Parent

        close(pipefd[0]);  // Parent doesn't read

        // Make pipe write end become stdout
        dup2(pipefd[1], STDOUT_FILENO);

        close(pipefd[1]);

        // Now stdout goes into the pipe
        printf("Hello from parent\n");
        fflush(stdout);

        wait(NULL);
    }

    return 0;
}



Key Comparison


Feature	dup(oldfd)	dup2(oldfd, newfd)
Arguments	Takes only the existing file descriptor (oldfd).	Takes the existing (oldfd) and the target descriptor (newfd).
FD Allocation	Automatically allocates the lowest available integer in the process's file descriptor table.	Forces the duplicate to use the user-specified newfd.
If Target FD is Open	Not applicable (it only uses unassigned descriptors).	Silently and atomically closes newfd first before reusing it.
If oldfd == newfd	Not applicable.	Does nothing and safely returns newfd.

