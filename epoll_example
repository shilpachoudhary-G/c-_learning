#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <fcntl.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/epoll.h>

#define PORT 8080
#define MAX_EVENTS 64
#define BUFFER_SIZE 1024

static int set_nonblocking(int fd)
{
    int flags = fcntl(fd, F_GETFL, 0);

    if (flags == -1)
        return -1;

    return fcntl(fd, F_SETFL, flags | O_NONBLOCK);
}

int main()
{
    int server_fd;
    int epoll_fd;

    struct sockaddr_in server_addr;
    struct epoll_event event;
    struct epoll_event events[MAX_EVENTS];

    // 1. Create TCP socket
    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd == -1) {
        perror("socket");
        exit(EXIT_FAILURE);
    }

    // 2. Make server socket non-blocking
    if (set_nonblocking(server_fd) == -1) {
        perror("fcntl");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // 3. Bind
    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) == -1) {
        perror("bind");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // 4. Listen
    if (listen(server_fd, 10) == -1) {
        perror("listen");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    printf("Server listening on port %d\n", PORT);

    // 5. Create epoll instance
    epoll_fd = epoll_create1(0);

    if (epoll_fd == -1) {
        perror("epoll_create1");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // 6. Add server socket to epoll
    memset(&event, 0, sizeof(event));

    event.events = EPOLLIN;
    event.data.fd = server_fd;

    if (epoll_ctl(epoll_fd,
                  EPOLL_CTL_ADD,
                  server_fd,
                  &event) == -1) {
        perror("epoll_ctl");
        close(epoll_fd);
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // 7. Event loop
    while (1) {

        int nready = epoll_wait(
            epoll_fd,
            events,
            MAX_EVENTS,
            -1
        );

        if (nready == -1) {

            if (errno == EINTR)
                continue;

            perror("epoll_wait");
            break;
        }

        // Process ready descriptors
        for (int i = 0; i < nready; i++) {

            int fd = events[i].data.fd;

            // New client connection
            if (fd == server_fd) {

                while (1) {

                    struct sockaddr_in client_addr;
                    socklen_t client_len =
                        sizeof(client_addr);

                    int client_fd = accept(
                        server_fd,
                        (struct sockaddr *)&client_addr,
                        &client_len
                    );

                    if (client_fd == -1) {

                        if (errno == EAGAIN ||
                            errno == EWOULDBLOCK) {
                            break;
                        }

                        perror("accept");
                        break;
                    }

                    // Make client socket non-blocking
                    if (set_nonblocking(client_fd) == -1) {
                        perror("fcntl");
                        close(client_fd);
                        continue;
                    }

                    printf("Client connected: fd=%d\n",
                           client_fd);

                    // Add client to epoll
                    struct epoll_event client_event;

                    memset(&client_event, 0,
                           sizeof(client_event));

                    client_event.events = EPOLLIN;
                    client_event.data.fd = client_fd;

                    if (epoll_ctl(
                            epoll_fd,
                            EPOLL_CTL_ADD,
                            client_fd,
                            &client_event) == -1) {

                        perror("epoll_ctl ADD");
                        close(client_fd);
                    }
                }
            }

            // Existing client
            else {

                if (events[i].events &
                    (EPOLLERR | EPOLLHUP)) {

                    printf("Client error/hangup fd=%d\n",
                           fd);

                    epoll_ctl(
                        epoll_fd,
                        EPOLL_CTL_DEL,
                        fd,
                        NULL
                    );

                    close(fd);
                    continue;
                }

                if (events[i].events & EPOLLIN) {

                    char buffer[BUFFER_SIZE];

                    int n = recv(
                        fd,
                        buffer,
                        sizeof(buffer) - 1,
                        0
                    );

                    if (n > 0) {

                        buffer[n] = '\0';

                        printf("Received from fd=%d: %s",
                               fd,
                               buffer);

                        // Echo back
                        send(fd,
                             buffer,
                             n,
                             0);
                    }
                    else if (n == 0) {

                        // Client closed connection
                        printf("Client disconnected fd=%d\n",
                               fd);

                        epoll_ctl(
                            epoll_fd,
                            EPOLL_CTL_DEL,
                            fd,
                            NULL
                        );

                        close(fd);
                    }
                    else {

                        if (errno != EAGAIN &&
                            errno != EWOULDBLOCK) {

                            perror("recv");

                            epoll_ctl(
                                epoll_fd,
                                EPOLL_CTL_DEL,
                                fd,
                                NULL
                            );

                            close(fd);
                        }
                    }
                }
            }
        }
    }


