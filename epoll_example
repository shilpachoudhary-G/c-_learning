    if (sockfd == -1) {
        perror("socket");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);

    inet_pton(AF_INET,
              "127.0.0.1",
              &server_addr.sin_addr);

    // Connect
    if (connect(sockfd,
                (struct sockaddr *)&server_addr,
                sizeof(server_addr)) == -1) {

        perror("connect");
        close(sockfd);
        exit(EXIT_FAILURE);
    }

    printf("Connected to server\n");

    while (1) {

        printf("Enter message: ");

        if (fgets(buffer,
                  sizeof(buffer),
                  stdin) == NULL)
            break;

        // Send
        int n = send(
            sockfd,
            buffer,
            strlen(buffer),
            0
        );

        if (n == -1) {
            perror("send");
            break;
        }

        // Receive echo
        n = recv(
            sockfd,
            buffer,
            sizeof(buffer) - 1,
            0
        );

        if (n <= 0)
            break;

        buffer[n] = '\0';

        printf("Server: %s", buffer);
    }

    close(sockfd);

    return 0;
