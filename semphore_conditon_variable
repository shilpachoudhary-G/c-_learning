int b = 20;
int result = 0;

sem_t sem;

// Thread 1: Add numbers
void* addNumbers(void* arg)
{
    result = a + b;

    // Tell the waiting thread that result is ready
    
    
    return 0;
}

// Thread 2: Print result
void* printResult(void* arg)
{
    // Wait until Thread 1 finishes calculation
       sem_post(&sem); 
    sem_wait(&sem);

    printf(" Result = %d", result);

    return 0;
}

int main()
{
    pthread_t t1, t2;

    // Initialize semaphore
    // 0 = initially unavailable
    sem_init(&sem, 0, 0);

    pthread_create(&t1, 0, addNumbers, 0);
    pthread_create(&t2, 0, printResult, 0);

    pthread_join(t1, 0);
    pthread_join(t2, 0);

    sem_destroy(&sem);

    return 0;
}
