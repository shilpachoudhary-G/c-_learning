#include <stdio.h>
#include<pthread.h> 

int a = 10;
int b = 20;
int result = 0;

bool calculation_done = false;

pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
pthread_cond_t cond = PTHREAD_COND_INITIALIZER;

// Worker thread
void* addNumbers(void* arg)
{
    pthread_mutex_lock(&mutex);

    result = a + b;
    calculation_done = true;

    // Notify the waiting thread
    pthread_cond_signal(&cond);

    pthread_mutex_unlock(&mutex);

    return nullptr;
}

// Main/waiting thread
void* printResult(void* arg)
{
    pthread_mutex_lock(&mutex);

    // Wait until calculation is completed
    while (!calculation_done)
    {
        pthread_cond_wait(&cond, &mutex);
    }

    std::cout << "Result = " << result << std::endl;

    pthread_mutex_unlock(&mutex);

    return nullptr;
}

int main()
{
    pthread_t t1, t2;

    pthread_create(&t1, nullptr, addNumbers, nullptr);
    pthread_create(&t2, nullptr, printResult, nullptr);

    pthread_join(t1, nullptr);
    pthread_join(t2, nullptr);

    pthread_mutex_destroy(&mutex);
    pthread_cond_destroy(&cond);

    return 0;
}

