#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <sys/mman.h>
#include <unistd.h>

typedef struct {
    pthread_mutex_t lock;
    int counter;
} shared_data_t;

int main() {
    shared_data_t *data = mmap(NULL, sizeof(shared_data_t),
        PROT_READ | PROT_WRITE,
        MAP_SHARED | MAP_ANONYMOUS, -1, 0);

    pthread_mutexattr_t attr;
    pthread_mutexattr_init(&attr);
    pthread_mutexattr_setpshared(&attr, PTHREAD_PROCESS_SHARED);

    pthread_mutex_init(&data->lock, &attr);
    data->counter = 0;

    pid_t pid = fork();

    if (pid == 0) { // child
        for (int i = 0; i < 5; i++) {
            pthread_mutex_lock(&data->lock);
            data->counter++;
            printf("Child: %d\n", data->counter);
            pthread_mutex_unlock(&data->lock);
            sleep(1);
        }
    } else { // parent
        for (int i = 0; i < 5; i++) {
            pthread_mutex_lock(&data->lock);
            data->counter++;
            printf("Parent: %d\n", data->counter);
            pthread_mutex_unlock(&data->lock);
            sleep(1);
        }
    }

    return 0;
}
